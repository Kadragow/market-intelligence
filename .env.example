# Copy to .env and fill in. Never commit .env.
# Not needed for `uv run mi weekly --mock --dry-run`.

# --- LLM via OpenRouter (key from https://openrouter.ai/settings/keys) ---
OPENROUTER_API_KEY=
# OpenRouter model slug. Pick one that supports structured outputs:
# https://openrouter.ai/models?supported_parameters=structured_outputs
# Free variants end in ":free" (set both prices below to 0 for them).
MI_LLM_MODEL=anthropic/claude-sonnet-5.5
MI_LLM_MAX_TOKENS=16000
MI_LLM_TIMEOUT_SECONDS=300
# Hard limit for one run; the run is aborted before the API call if the estimate exceeds it.
MI_LLM_MAX_COST_USD=0.50
# Max USD per million tokens for MI_LLM_MODEL (sent to OpenRouter as provider.max_price).
# Check the model page on openrouter.ai.
MI_LLM_INPUT_USD_PER_MTOK=2.0
MI_LLM_OUTPUT_USD_PER_MTOK=10.0
# allow (OpenRouter default) | deny (only providers that do not store prompts)
MI_LLM_DATA_COLLECTION=allow

# --- Macro data: FRED (free key from https://fred.stlouisfed.org/docs/api/api_key.html) ---
# Optional: without it the macro section is marked as missing data.
FRED_API_KEY=
MI_MACRO_HISTORY_DAYS=550

# --- Paths ---
MI_CONFIG_DIR=config
MI_REPORTS_DIR=reports

# --- Data ---
MI_PRICE_HISTORY_DAYS=90
MI_STALE_AFTER_BUSINESS_DAYS=5
# More consecutive missing business days than this is reported as a data gap.
MI_PRICE_MAX_GAP_BUSINESS_DAYS=3
MI_NEWS_LOOKBACK_DAYS=7
MI_NEWS_MAX_ITEMS_PER_SOURCE=20
MI_NEWS_MAX_ITEMS_FOR_LLM=40
MI_HTTP_TIMEOUT_SECONDS=15
# Retries for RSS, yfinance, FRED and OpenRouter (exponential backoff with jitter,
# Retry-After honoured up to the max). OpenRouter is retried only on 429/503/connect errors.
MI_HTTP_MAX_ATTEMPTS=3
MI_HTTP_BACKOFF_BASE_SECONDS=1.0
MI_HTTP_BACKOFF_MAX_SECONDS=30.0

# --- E-mail (sent only if MI_EMAIL_ENABLED=true, SMTP is complete and --send is given) ---
MI_EMAIL_ENABLED=false
MI_SMTP_HOST=
MI_SMTP_PORT=587
MI_SMTP_USERNAME=
MI_SMTP_PASSWORD=
MI_SMTP_USE_STARTTLS=true
MI_EMAIL_FROM=
# Comma-separated
MI_EMAIL_TO=
