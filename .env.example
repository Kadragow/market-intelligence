# Copy to .env and fill in. Never commit .env.
# Not needed for `uv run mi weekly --mock --dry-run`.

# --- Claude API (billed separately in Claude Console; not covered by Claude Pro) ---
ANTHROPIC_API_KEY=
MI_LLM_MODEL=claude-sonnet-5-5
MI_LLM_MAX_TOKENS=16000
MI_LLM_TIMEOUT_SECONDS=300
# Hard limit for one run; the run is aborted before the API call if the estimate exceeds it.
MI_LLM_MAX_COST_USD=0.50
# USD per million tokens for MI_LLM_MODEL; check https://platform.claude.com/docs/en/about-claude/pricing
MI_LLM_INPUT_USD_PER_MTOK=2.0
MI_LLM_OUTPUT_USD_PER_MTOK=10.0
MI_LLM_REFUSAL_FALLBACK=true

# --- Paths ---
MI_CONFIG_DIR=config
MI_REPORTS_DIR=reports

# --- Data ---
MI_PRICE_HISTORY_DAYS=90
MI_STALE_AFTER_BUSINESS_DAYS=5
MI_NEWS_LOOKBACK_DAYS=7
MI_NEWS_MAX_ITEMS_PER_SOURCE=20
MI_NEWS_MAX_ITEMS_FOR_LLM=40
MI_HTTP_TIMEOUT_SECONDS=15

# --- E-mail (sent only if MI_EMAIL_ENABLED=true, SMTP is complete and --send is given) ---
MI_EMAIL_ENABLED=false
MI_SMTP_HOST=
MI_SMTP_PORT=587
MI_SMTP_USERNAME=
MI_SMTP_PASSWORD=
MI_SMTP_USE_STARTTLS=true
MI_EMAIL_FROM=
# Comma-separated
MI_EMAIL_TO=
